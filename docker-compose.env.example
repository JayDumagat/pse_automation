# Copy this file to .env before running `docker compose up --build`.
# The app starts without this key, but caption generation will be skipped and
# recorded as a warning until a valid OpenAI API key is set.
OPENAI_API_KEY=

DB_NAME=pse_daily_pulse
BACKEND_PORT=8000
FRONTEND_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
